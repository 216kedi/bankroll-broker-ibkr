# MySQL Veritabanı Bağlantı Ayarları
# Bu dosyayı .env olarak kopyalayın ve kendi ayarlarınızı girin

# Veritabanı Host Adresi
DB_HOST=localhost

# Veritabanı Kullanıcı Adı
DB_USER=root

# Veritabanı Şifresi
DB_PASSWORD=your_password_here

# Veritabanı Adı
DB_DATABASE=tapu

# Uygulama Ayarları
# Port numarası (varsayılan: 5000)
PORT=5000

# Debug modu (development için True, production için False)
DEBUG=True
